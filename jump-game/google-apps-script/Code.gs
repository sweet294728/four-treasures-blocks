var SHEET_NAME='JumpRankings';
var PROPERTY_KEY='JUMP_RANKING_SPREADSHEET_ID';
var HEADERS=['requestId','submittedAt','nickname','normalizedNickname','score','character','golden'];
function setupLeaderboard(){var props=PropertiesService.getScriptProperties(),id=props.getProperty(PROPERTY_KEY),ss=id?SpreadsheetApp.openById(id):SpreadsheetApp.create('呼吸小氣球跳台挑戰排行榜');props.setProperty(PROPERTY_KEY,ss.getId());ensureSheet_();Logger.log('排行榜試算表：'+ss.getUrl())}
function ensureSheet_(){var id=PropertiesService.getScriptProperties().getProperty(PROPERTY_KEY);if(!id)throw new Error('排行榜尚未設定');var ss=SpreadsheetApp.openById(id),sh=ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(HEADERS);return sh}
function validate_(p){var name=String(p.nickname||'').normalize('NFKC').trim(),score=Number(p.score),character=String(p.character||''),id=String(p.requestId||''),golden=String(p.golden||'0');if(!name||Array.from(name).length>12||/[\u0000-\u001f\u007f]/.test(name)||/^[=+\-@]/.test(name))throw new Error('暱稱格式錯誤');if(!Number.isSafeInteger(score)||score<0||score>999999999)throw new Error('分數格式錯誤');if(!/^[cdke]$/.test(character))throw new Error('角色格式錯誤');if(!/^[A-Za-z0-9_-]{8,80}$/.test(id))throw new Error('識別碼格式錯誤');if(!/^[01]$/.test(golden))throw new Error('模式格式錯誤');return {name:name,normalized:name.toLowerCase(),score:score,character:character,id:id,golden:golden}}
function list_(){var sh=ensureSheet_(),n=sh.getLastRow();if(n<2)return [];var best=Object.create(null);sh.getRange(2,1,n-1,HEADERS.length).getValues().forEach(function(r){var key=String(r[3]),item={name:String(r[2]),score:Number(r[4]),character:String(r[5]),golden:String(r[6])==='1',at:Date.parse(r[1])||0};if(!best[key]||item.score>best[key].score)best[key]=item});return Object.keys(best).map(function(k){return best[k]}).sort(function(a,b){return b.score-a.score||a.at-b.at}).slice(0,20)}
function doGet(e){var cb=String(e.parameter.callback||'');if(!/^__[A-Za-z0-9_]+$/.test(cb))cb='__invalid';var payload;try{payload={ok:true,records:list_()};var id=String(e.parameter.requestId||'');if(id){if(!/^[A-Za-z0-9_-]{8,80}$/.test(id))throw new Error('識別碼格式錯誤');var sh=ensureSheet_(),n=sh.getLastRow();payload.submitted=n>1&&sh.getRange(2,1,n-1,1).getValues().some(function(r){return r[0]===id})}}catch(err){payload={ok:false,error:String(err.message||err)}}return ContentService.createTextOutput(cb+'('+JSON.stringify(payload)+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}
function response_(p){var safe=JSON.stringify(p).replace(/</g,'\\u003c').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');return HtmlService.createHtmlOutput('<script>parent.postMessage('+safe+',"*");<\/script>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function doPost(e){var lock=LockService.getScriptLock();try{lock.waitLock(10000);var x=validate_(e.parameter),sh=ensureSheet_(),n=sh.getLastRow();if(n>1&&sh.getRange(2,1,n-1,1).getValues().some(function(r){return r[0]===x.id}))return response_({source:'jump-leaderboard',requestId:x.id,ok:true});sh.appendRow([x.id,new Date().toISOString(),x.name,x.normalized,x.score,x.character,x.golden]);return response_({source:'jump-leaderboard',requestId:x.id,ok:true})}catch(err){return response_({source:'jump-leaderboard',requestId:String(e.parameter.requestId||''),ok:false,error:String(err.message||err)})}finally{if(lock.hasLock())lock.releaseLock()}}
