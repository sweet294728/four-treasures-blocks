var SHEET_NAME='GomokuRankings',PROPERTY_KEY='GOMOKU_RANKING_SPREADSHEET_ID',HEADERS=['requestId','submittedAt','nickname','normalizedNickname','seconds','moves','difficulty'];
function setupLeaderboard(){var p=PropertiesService.getScriptProperties(),id=p.getProperty(PROPERTY_KEY),ss=id?SpreadsheetApp.openById(id):SpreadsheetApp.create('四寶五子棋排行榜');p.setProperty(PROPERTY_KEY,ss.getId());ensureSheet_();Logger.log('排行榜試算表：'+ss.getUrl())}
function ensureSheet_(){var id=PropertiesService.getScriptProperties().getProperty(PROPERTY_KEY);if(!id)throw new Error('排行榜尚未設定');var ss=SpreadsheetApp.openById(id),sh=ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(HEADERS);return sh}
function validate_(p){var name=String(p.nickname||'').normalize('NFKC').trim(),seconds=Number(p.seconds),moves=Number(p.moves),difficulty=String(p.difficulty||''),id=String(p.requestId||'');if(!name||Array.from(name).length>12||/[\u0000-\u001f\u007f]/.test(name)||/^[=+\-@]/.test(name))throw new Error('暱稱格式錯誤');if(!Number.isSafeInteger(seconds)||seconds<1||seconds>86400)throw new Error('時間格式錯誤');if(!Number.isSafeInteger(moves)||moves<5||moves>113)throw new Error('落子數格式錯誤');if(!/^(easy|hard)$/.test(difficulty))throw new Error('難度格式錯誤');if(!/^[A-Za-z0-9_-]{8,80}$/.test(id))throw new Error('識別碼格式錯誤');return {name:name,normalized:name.toLowerCase(),seconds:seconds,moves:moves,difficulty:difficulty,id:id}}
function list_(){var sh=ensureSheet_(),n=sh.getLastRow();if(n<2)return [];var best=Object.create(null);sh.getRange(2,1,n-1,HEADERS.length).getValues().forEach(function(r){var key=String(r[3])+'|'+String(r[6]),item={name:String(r[2]),seconds:Number(r[4]),moves:Number(r[5]),difficulty:String(r[6]),at:Date.parse(r[1])||0};if(!best[key]||item.seconds<best[key].seconds||item.seconds===best[key].seconds&&item.moves<best[key].moves)best[key]=item});var items=Object.keys(best).map(function(k){return best[k]}).sort(function(a,b){return a.seconds-b.seconds||a.moves-b.moves||a.at-b.at});return items.filter(function(r){return r.difficulty==='easy'}).slice(0,20).concat(items.filter(function(r){return r.difficulty==='hard'}).slice(0,20))}
function doGet(e){var cb=String(e.parameter.callback||'');if(!/^__[A-Za-z0-9_]+$/.test(cb))cb='__invalid';var payload;try{payload={ok:true,records:list_()};var id=String(e.parameter.requestId||'');if(id){if(!/^[A-Za-z0-9_-]{8,80}$/.test(id))throw new Error('識別碼格式錯誤');var sh=ensureSheet_(),n=sh.getLastRow();payload.submitted=n>1&&sh.getRange(2,1,n-1,1).getValues().some(function(r){return r[0]===id})}}catch(err){payload={ok:false,error:String(err.message||err)}}return ContentService.createTextOutput(cb+'('+JSON.stringify(payload)+');').setMimeType(ContentService.MimeType.JAVASCRIPT)}
function response_(p){var safe=JSON.stringify(p).replace(/</g,'\\u003c').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');return HtmlService.createHtmlOutput('<script>parent.postMessage('+safe+',"*");<\/script>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function doPost(e){var lock=LockService.getScriptLock();try{lock.waitLock(10000);var x=validate_(e.parameter),sh=ensureSheet_(),n=sh.getLastRow();if(n>1&&sh.getRange(2,1,n-1,1).getValues().some(function(r){return r[0]===x.id}))return response_({source:'gomoku-leaderboard',requestId:x.id,ok:true});sh.appendRow([x.id,new Date().toISOString(),x.name,x.normalized,x.seconds,x.moves,x.difficulty]);return response_({source:'gomoku-leaderboard',requestId:x.id,ok:true})}catch(err){return response_({source:'gomoku-leaderboard',requestId:String(e.parameter.requestId||''),ok:false,error:String(err.message||err)})}finally{if(lock.hasLock())lock.releaseLock()}}

